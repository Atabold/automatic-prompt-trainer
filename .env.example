# Everything here is OPTIONAL.
#
# API keys are normally entered in the app's Settings tab and stored in
# data/secrets.json (gitignored). These variables only act as a fallback the
# first time the app starts — useful for CI or a headless machine.

# APP_ENV=DEV enables debug-level terminal logging. PROD keeps the console quiet.
# Either way, everything is written to logs/app.log.
APP_ENV=PROD

# --- API providers (set only the one you use) ---
# MISTRAL_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# ZAI_API_KEY=
# DASHSCOPE_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# MOONSHOT_API_KEY=

# --- Routers & gateways (one key, many vendors) ---
# CORTECS_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# OPENROUTER_API_KEY=

# --- Hugging Face ---
# Only needed to download gated or private model repos.
# HF_TOKEN=
